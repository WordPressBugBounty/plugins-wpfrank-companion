{"leatherhouse-sidebar-primary":{"block-2":{"content":"<!-- wp:search \/-->"},"block-3":{"content":"<!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading --><h2>Recent Posts<\/h2><!-- \/wp:heading --><!-- wp:latest-posts \/--><\/div><!-- \/wp:group -->"},"block-4":{"content":"<!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading --><h2>Recent Comments<\/h2><!-- \/wp:heading --><!-- wp:latest-comments {\"displayAvatar\":false,\"displayDate\":false,\"displayExcerpt\":false} \/--><\/div><!-- \/wp:group -->"}},"leatherhouse-footer-1":{"block-12":{"content":"<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\"><strong>Modern House Pro<\/strong><\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:separator -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n<!-- \/wp:separator -->\n\n<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"style\":{\"typography\":{\"letterSpacing\":\"1px\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-small-font-size\" style=\"letter-spacing:1px\">Indulge in the timeless elegance of our Leather House Premium theme. Crafted with meticulous attention to detail, this theme features rich, textured leather accents that add a touch of luxury to your home. From the soft, supple cushions to the smooth, polished surfaces, every element is designed to create a sophisticated and inviting ambiance.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group --><\/div>\n<!-- \/wp:group --><\/div>\n<!-- \/wp:group -->"}},"leatherhouse-footer-2":{"block-17":{"content":"<!-- wp:calendar \/-->"}},"leatherhouse-footer-3":{"block-21":{"content":"<!-- wp:gallery {\"linkTo\":\"none\"} -->\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped\"><!-- wp:image {\"id\":80,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https:\/\/wpfrank.com\/demo\/modern-house-pro\/wp-content\/uploads\/sites\/55\/2025\/06\/blog-1-777x1024.webp\" alt=\"\" class=\"wp-image-80\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"id\":79,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https:\/\/wpfrank.com\/demo\/modern-house-pro\/wp-content\/uploads\/sites\/55\/2025\/06\/blog-2-777x1024.webp\" alt=\"\" class=\"wp-image-79\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"id\":78,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https:\/\/wpfrank.com\/demo\/modern-house-pro\/wp-content\/uploads\/sites\/55\/2025\/06\/blog-3-777x1024.webp\" alt=\"\" class=\"wp-image-78\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"id\":19,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https:\/\/wpfrank.com\/demo\/modern-house-pro\/wp-content\/uploads\/sites\/55\/2025\/06\/future-living.png\" alt=\"future-living\" class=\"wp-image-19\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"id\":17,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https:\/\/wpfrank.com\/demo\/modern-house-pro\/wp-content\/uploads\/sites\/55\/2025\/06\/curated-spaces.png\" alt=\"curated-spaces\" class=\"wp-image-17\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"id\":12,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https:\/\/wpfrank.com\/demo\/modern-house-pro\/wp-content\/uploads\/sites\/55\/2025\/06\/mh-about-2-682x1024.webp\" alt=\"\" class=\"wp-image-12\"\/><\/figure>\n<!-- \/wp:image --><\/figure>\n<!-- \/wp:gallery -->"}},"leatherhouse-woocommerce-sidebar":{"block-5":{"content":"<!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading --><h2>Archives<\/h2><!-- \/wp:heading --><!-- wp:archives \/--><\/div><!-- \/wp:group -->"},"block-6":{"content":"<!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading --><h2>Categories<\/h2><!-- \/wp:heading --><!-- wp:categories \/--><\/div><!-- \/wp:group -->"}}}